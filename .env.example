NODE_ENV=production
PORT=3000
ACCESS_TOKEN_SECRET=replace-with-at-least-64-random-characters
APP_ORIGIN=https://app.example.com
APP_TIME_ZONE=Asia/Jakarta
DB_POOL_SIZE=5
DATABASE_URL=postgresql://user:password@external-postgres.example.com:5432/ctj?sslmode=require

# Optional: only required for transactional email.
RESEND_API_KEY=
EMAIL_FROM="Connected to Jannah <no-reply@example.com>"

# The variables below are only used by the optional Docker deployment.
WEB_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
POSTGRES_DB=ctj
POSTGRES_USER=ctj
POSTGRES_PASSWORD=change-me
